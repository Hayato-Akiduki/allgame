{
  "name": "allgame",
  "productName": "ALLGAME",
  "version": "1.3.0",
  "description": "自作ゲームの詰め合わせサイト",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "start": "npm run site && electron .",
    "dist": "npm run site && electron-builder --win --x64 --publish never",
    "site": "node scripts/build-site.js",
    "site:serve": "node scripts/build-site.js && node scripts/serve-site.js"
  },
  "build": {
    "appId": "com.akiduki.allgame",
    "files": ["app/**/*", "site-dist/**/*"],
    "publish": {
      "provider": "github",
      "owner": "Hayato-Akiduki",
      "repo": "allgame"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ALLGAME-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
